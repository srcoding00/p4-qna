{
  "name": "AuroraStay policy Q&A",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [
    8501,
    7860
  ],
  "portsAttributes": {
    "8501": {
      "label": "AuroraStay staff interface",
      "onAutoForward": "openBrowser"
    },
    "7860": {
      "label": "AuroraStay backend API",
      "onAutoForward": "notify"
    }
  }
}
